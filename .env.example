# File MẪU. Chép thành .env rồi điền key thật vào đó:
#     Copy-Item .env.example .env
# Không bao giờ điền key thật vào file này — nó được commit lên git.

# ── BẮT BUỘC ────────────────────────────────────────────────────────────────
# Thiếu bất kỳ dòng nào dưới đây là chương trình dừng ngay lúc IMPORT, không
# phải lúc gọi LLM. Triệu chứng: `ValueError: Thiếu biến môi trường LLM_MODEL`
# hoặc `openai.OpenAIError: Missing credentials`.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini

# ── TUỲ CHỌN ────────────────────────────────────────────────────────────────
# Model làm judge khi chạy eval. Bỏ trống thì dùng theo LLM_MODEL.
LLM_MODEL_EVAL=gpt-5.4-mini

# Ba cờ tham số model — điền theo kết quả `python tools/probe_model.py`, KHÔNG
# đoán. Sai một cờ là mọi lệnh gọi trả 400. Giá trị dưới đúng cho gpt-5.4-mini.
LLM_TOKEN_ARG=max_completion_tokens
LLM_USE_TEMP=1
LLM_USE_EFFORT=1

# ── KHÔNG cần khai báo ──────────────────────────────────────────────────────
# Model embedding chạy cục bộ (sentence-transformers/paraphrase-multilingual-
# MiniLM-L12-v2), KHÔNG dùng API key. Nhưng lần chạy đầu tải ~458MB từ
# HuggingFace nên cần mạng và một chút kiên nhẫn.

# ── Đổi sang Anthropic ──────────────────────────────────────────────────────
# Chạy lại probe rồi điền lại ba cờ ở trên, đừng bê nguyên giá trị của OpenAI.
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# LLM_MODEL_EVAL=claude-opus-5
