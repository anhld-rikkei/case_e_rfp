# Chỉ khai báo tên biến; không điền API key thật vào file này.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_MODEL_EVAL=gpt-5.4-mini

# Ba cờ dưới đây điền theo kết quả chạy `python tools/probe_model.py`, không đoán.
# Sai một cái là mọi lệnh gọi trả 400. Giá trị dưới là của gpt-5.4-mini.
LLM_TOKEN_ARG=max_completion_tokens
LLM_USE_TEMP=1
LLM_USE_EFFORT=1

# Đổi sang Anthropic — chạy lại probe rồi điền lại ba cờ trên
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# LLM_MODEL_EVAL=claude-opus-5
